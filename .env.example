# ── Database (Hostinger hPanel → Databases → MySQL Databases) ──
# On the Hostinger server itself the host is usually "localhost".
# For local development, enable Remote MySQL in hPanel and use the server's hostname/IP.
DATABASE_URL="mysql://u629172807_daily_pet_care:Daily_Pet_Care_2024@localhost:3306/u629172807_daily_pet_care"

# ── Auth ── generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET="replace-with-a-long-random-string"

# ── Public site URL (no trailing slash) — used for SEO, sitemap, RSS, OG tags ──
NEXT_PUBLIC_SITE_URL="https://mistyrose-rhinoceros-640925.hostingsite.com"

# ── First admin account (used only by `npm run db:seed`) ──
SEED_ADMIN_EMAIL="admin@mistyrose-rhinoceros-640925.hostingsite.com"
SEED_ADMIN_PASSWORD="ChangeMe!2026"
SEED_ADMIN_NAME="Site Admin"

# ── Uploads folder (absolute path recommended on Hostinger so files survive redeploys) ──
# e.g. /home/u629172807/petblog-uploads
UPLOAD_DIR="./uploads"